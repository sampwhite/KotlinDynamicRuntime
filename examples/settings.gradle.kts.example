// ============================================================================
// EXAMPLE settings file — this is a TEMPLATE, not a live build script.
//
// The real settings.gradle.kts is NOT version-controlled. It is supplied
// per-deployment in the directory that *contains* `KotlinDynamicRuntime/`, so
// that a single Gradle build can span multiple source repositories. This file
// is the version-controlled example a deployment copies and adapts.
//
// To use it:
//   1. Copy this file to the directory that contains `KotlinDynamicRuntime/`.
//   2. Rename it to `settings.gradle.kts`.
//   3. Adjust as needed (e.g. add more `includeBuild`/`include` lines to pull
//      in code from additional source repositories for this deployment).
//
// The `.example` extension keeps Gradle and the IDE from treating this file as
// an actual settings script.
// ============================================================================

// Wire in the version-controlled `build-logic` build so its convention plugins
// (e.g. `kdr.kotlin-conventions`) are resolvable from each module's `plugins {}`
// block. This is the only line of build wiring that the shared logic needs from
// this non-versioned, per-deployment settings file.
pluginManagement {
    includeBuild("KotlinDynamicRuntime/build-logic")
}

rootProject.name = "KotlinDynamicRuntime"

// >>> kdr-injection-prologue — deployment-injection helper (issue #171); kept in sync by kdr-install.
// Convenience helper for co-building deployment-injected provider projects (custom config now, custom
// components later). Each injectComponent(...) call includes the project (re-pointed at its real directory) AND
// records its path, so the versioned `launch` build can add it to its runtime classpath via
// `wireInjectedComponents()` — without the versioned build ever naming it. This settings file is therefore the
// single, auditable control point for what deployment code enters the build.
val kdrInjectedComponents = mutableListOf<String>()
fun injectComponent(path: String, dir: String) {
    include(path)
    project(path).projectDir = file(dir)
    kdrInjectedComponents += path
}
// Publish the registry so `launch` (via wireInjectedComponents()) can read it. The lambda runs when the root
// project is configured — after this settings script finishes — so it captures every injectComponent(...) call
// regardless of where those calls appear below. Harmless when nothing was injected.
gradle.rootProject { extra["kdrInjectedComponents"] = kdrInjectedComponents.toList() }
// <<< kdr-injection-prologue

// The Gradle subprojects. Their physical layout lives under the
// `KotlinDynamicRuntime` directory, so the logical project paths below are
// re-pointed at their real directories with `projectDir`. `sample` (a demo the
// launcher compile-depends on), `webapp` (the Kotlin/JS front end), and `appui`
// (the JVM host that serves the webapp's bundle under the `wa` context root) are
// part of the default deployment; comment out an `include` line to leave a project
// out.
include("launch")
include("config")
include("base:kernel")
include("base:common")
include("base:kdn")
include("sample")
include("webapp")
include("appui")

project(":base").projectDir = file("KotlinDynamicRuntime/base")
project(":launch").projectDir = file("KotlinDynamicRuntime/launch")
project(":config").projectDir = file("KotlinDynamicRuntime/config")
project(":base:kernel").projectDir = file("KotlinDynamicRuntime/base/kernel")
project(":base:common").projectDir = file("KotlinDynamicRuntime/base/common")
project(":base:kdn").projectDir = file("KotlinDynamicRuntime/base/kdn")
project(":sample").projectDir = file("KotlinDynamicRuntime/sample")
project(":webapp").projectDir = file("KotlinDynamicRuntime/webapp")
project(":appui").projectDir = file("KotlinDynamicRuntime/appui")

// Deployment-specific configuration code, discovered at startup via the JVM ServiceLoader (issue #171).
// `injectComponent` both includes the `:customConfig` project and records it so `launch` wires it onto its
// runtime classpath — the whole setup a deployment needs. See examples/custom-config.md for the full walkthrough
// (the provider class, its package, and the `META-INF/services` file). Uncomment to enable:
//
//   injectComponent(":customConfig", "customConfig")
//
// A client component from a private sibling checkout would be another line, e.g.:
//
//   injectComponent(":acmeBilling", "../acme-private/billing")
